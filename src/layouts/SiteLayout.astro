---
import { translations, type SiteCopy } from "../i18n";
import { localeNames, localizedRoutes, siteLocales } from "../i18n/routes";
import "../styles/global.css";

interface Props {
  copy: SiteCopy;
  page?: {
    kind: "privacy" | "support";
    title: string;
    description: string;
  };
}

const { copy, page } = Astro.props;
const languages = siteLocales.map((locale) => ({
  locale,
  name: localeNames[locale],
  htmlLang: translations[locale].htmlLang,
  ogLocale: translations[locale].ogLocale,
  path: localizedRoutes[locale][page?.kind ?? "home"],
}));
const languageUrls = Object.fromEntries(
  languages.map(({ locale, path }) => [locale, path]),
);
const canonicalPath = languageUrls[copy.locale];
const homePath = localizedRoutes[copy.locale].home;
const privacyPath = localizedRoutes[copy.locale].privacy;
const supportPath = localizedRoutes[copy.locale].support;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const defaultAbsoluteUrl = new URL(languageUrls.en, Astro.site);
const imageUrl = new URL("/brand/kokage-app-icon.png", Astro.site);
const meta = page ?? copy.meta;
const isHomePage = page === undefined;
const schema = {
  "@context": "https://schema.org",
  "@type": isHomePage ? "WebSite" : "WebPage",
  name: isHomePage ? copy.brandLabel : meta.title,
  url: canonicalUrl.href,
  description: meta.description,
  inLanguage: copy.htmlLang,
  ...(isHomePage
    ? {}
    : {
        isPartOf: {
          "@type": "WebSite",
          name: copy.brandLabel,
          url: new URL(homePath, Astro.site).href,
        },
      }),
};
---

<!doctype html>
<html
  lang={copy.htmlLang}
  data-site-locale={copy.locale}
  data-language-urls={JSON.stringify(languageUrls)}
  data-language-auto-detect={copy.locale === "en" ? "true" : "false"}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d1411" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="index, follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic&amp;display=swap"
    />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      languages.map(({ htmlLang, path }) => (
        <link rel="alternate" hreflang={htmlLang} href={new URL(path, Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultAbsoluteUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.brandLabel} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={copy.ogLocale} />
    {
      languages
        .filter(({ locale }) => locale !== copy.locale)
        .map(({ ogLocale }) => (
          <meta property="og:locale:alternate" content={ogLocale} />
        ))
    }
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content={copy.hero.imageAlt} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={copy.hero.imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/brand/kokage-app-icon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/kokage-app-icon-192.png" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script>
      import { initializeLanguageMenu } from "../scripts/language-menu.mjs";
      import { initializeLanguagePreference } from "../scripts/language-preference.mjs";

      initializeLanguagePreference();
      initializeLanguageMenu();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{copy.skipLink}</a>

    <header class="site-header">
      <div class="header-shell">
        <a
          class="brand"
          href={homePath}
          aria-label={`${copy.brandLabel} ${copy.navigation.homeLabel}`}
        >
          <img
            class="brand__mark"
            src="/brand/kokage-app-icon.svg"
            alt=""
            width="40"
            height="40"
          />
          <span class="brand__name">{copy.brandLabel}</span>
        </a>

        <nav class="site-nav" aria-label={copy.navigation.label}>
          {
            copy.navigation.items.map((item) => (
              <a href={isHomePage ? item.href : `${homePath}${item.href}`}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <nav class="language-switch" aria-label={copy.navigation.languageLabel}>
          <details class="language-menu">
            <summary class="language-menu__toggle">
              <svg
                class="language-menu__globe"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3Z" />
              </svg>
              <span class="visually-hidden">{copy.navigation.languageLabel}: </span>
              <span class="language-menu__current">{localeNames[copy.locale]}</span>
              <svg
                class="language-menu__chevron"
                viewBox="0 0 12 12"
                width="10"
                height="10"
                aria-hidden="true"
              >
                <path d="m2.5 4.5 3.5 3.5 3.5-3.5" />
              </svg>
            </summary>
            <ul class="language-menu__list" role="list">
              {
                languages.map(({ locale, name, htmlLang, path }) => (
                  <li>
                    <a
                      href={path}
                      hreflang={htmlLang}
                      lang={htmlLang}
                      data-language-option={locale}
                      aria-current={copy.locale === locale ? "page" : undefined}
                    >
                      {name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-shell">
        <a
          class="brand brand--footer"
          href={homePath}
          aria-label={`${copy.brandLabel} ${copy.navigation.homeLabel}`}
        >
          <img
            class="brand__mark"
            src="/brand/kokage-app-icon.svg"
            alt=""
            width="40"
            height="40"
            loading="lazy"
          />
          <span class="brand__name">{copy.brandLabel}</span>
        </a>
        <p>{copy.footer.descriptor}</p>
        <nav class="footer-nav" aria-label={copy.footer.navigationLabel}>
          <a href={isHomePage ? "#status" : `${homePath}#status`}>
            {copy.footer.statusLink}
          </a>
          <a
            href={privacyPath}
            aria-current={page?.kind === "privacy" ? "page" : undefined}
          >
            {copy.footer.privacyLink}
          </a>
          <a
            href={supportPath}
            aria-current={page?.kind === "support" ? "page" : undefined}
          >
            {copy.footer.supportLink}
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>
