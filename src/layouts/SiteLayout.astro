---
import { translations, type SiteCopy } from "../i18n";
import {
  communityLinks,
  kokageCloudUrls,
  localeNames,
  localizedRoutes,
  siteLocales,
} from "../i18n/routes";
import { jsonLdText, structuredData } from "../seo/structured-data";
import "../styles/global.css";

interface Props {
  copy: SiteCopy;
  page?: {
    kind: "privacy" | "support";
    title: string;
    description: string;
  };
}

const { copy, page } = Astro.props;
const languages = siteLocales.map((locale) => ({
  locale,
  name: localeNames[locale],
  htmlLang: translations[locale].htmlLang,
  ogLocale: translations[locale].ogLocale,
  path: localizedRoutes[locale][page?.kind ?? "home"],
}));
const languageUrls = Object.fromEntries(
  languages.map(({ locale, path }) => [locale, path]),
);
const canonicalPath = languageUrls[copy.locale];
const homePath = localizedRoutes[copy.locale].home;
const privacyPath = localizedRoutes[copy.locale].privacy;
const supportPath = localizedRoutes[copy.locale].support;
const cloudAccountUrl = kokageCloudUrls[copy.locale];
const canonicalUrl = new URL(canonicalPath, Astro.site);
const defaultAbsoluteUrl = new URL(languageUrls.en, Astro.site);
const imageUrl = new URL("/brand/kokage-app-icon.png", Astro.site);
const meta = page ?? copy.meta;
const isHomePage = page === undefined;
const loadZenMaruGothic = copy.locale === "en" || copy.locale === "ja";
const schema = jsonLdText(
  structuredData(copy, page?.kind ?? "home", Astro.site!),
);
---

<!doctype html>
<html
  lang={copy.htmlLang}
  data-site-locale={copy.locale}
  data-language-urls={JSON.stringify(languageUrls)}
  data-language-auto-detect={copy.locale === "en" ? "true" : "false"}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0e1513"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#f7f6f1"
    />
    <meta name="robots" content="index, follow" />

    <script is:inline>
      (() => {
        try {
          const stored = window.localStorage.getItem("kokage-theme");
          const theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
    <noscript>
      <style>
        [data-theme-toggle],
        .screen-tabs,
        [data-motion-toggle] {
          display: none !important;
        }
        [data-screen-switcher] .device-frame {
          aspect-ratio: auto;
        }
        [data-screen-switcher] .device-frame__screen {
          display: flex;
          flex-direction: column;
          gap: 8px;
        }
        [data-screen-switcher] .device-screen--switchable {
          position: static;
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
        }
      </style>
    </noscript>

    {
      loadZenMaruGothic && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&amp;display=swap"
          />
        </>
      )
    }

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      languages.map(({ htmlLang, path }) => (
        <link rel="alternate" hreflang={htmlLang} href={new URL(path, Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultAbsoluteUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.brandLabel} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={copy.ogLocale} />
    {
      languages
        .filter(({ locale }) => locale !== copy.locale)
        .map(({ ogLocale }) => (
          <meta property="og:locale:alternate" content={ogLocale} />
        ))
    }
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content={copy.hero.imageAlt} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content={communityLinks.x.handle} />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={copy.hero.imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/brand/kokage-app-icon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/kokage-app-icon-192.png" />

    <script is:inline type="application/ld+json" set:html={schema} />
    <script>
      import { initializeLanguageMenu } from "../scripts/language-menu.mjs";
      import { initializeLanguagePreference } from "../scripts/language-preference.mjs";
      import { initializeTheme } from "../scripts/theme.mjs";

      initializeTheme();
      initializeLanguagePreference();
      initializeLanguageMenu();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{copy.skipLink}</a>

    <header class="site-header">
      <div class="header-shell">
        <a
          class="brand"
          href={homePath}
          aria-label={`${copy.brandLabel} ${copy.navigation.homeLabel}`}
        >
          <img
            class="brand__mark"
            src="/brand/kokage-app-icon.svg"
            alt=""
            width="34"
            height="34"
          />
          <span class="brand__name">{copy.brandLabel}</span>
        </a>

        <div class="header-actions">
          <nav class="site-nav" aria-label={copy.navigation.label}>
            <a
              href={supportPath}
              aria-current={page?.kind === "support" ? "page" : undefined}
            >
              {copy.navigation.supportLabel}
            </a>
            <a href={cloudAccountUrl} rel="external">
              {copy.navigation.cloudLabel}
              <span aria-hidden="true">↗</span>
            </a>
          </nav>

          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            data-label-light={copy.navigation.themeToggleLight}
            data-label-dark={copy.navigation.themeToggleDark}
            aria-label={copy.navigation.themeToggleLight}
            title={copy.navigation.themeToggleLight}
          >
            <svg
              class="theme-toggle__sun"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
            </svg>
            <svg
              class="theme-toggle__moon"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
          </button>

          <nav class="language-switch" aria-label={copy.navigation.languageLabel}>
            <details class="language-menu">
              <summary class="language-menu__toggle">
                <svg
                  class="language-menu__globe"
                  viewBox="0 0 24 24"
                  width="15"
                  height="15"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3Z" />
                </svg>
                <span class="visually-hidden">{copy.navigation.languageLabel}: </span>
                <span class="language-menu__current">{localeNames[copy.locale]}</span>
                <svg
                  class="language-menu__chevron"
                  viewBox="0 0 12 12"
                  width="10"
                  height="10"
                  aria-hidden="true"
                >
                  <path d="m2.5 4.5 3.5 3.5 3.5-3.5" />
                </svg>
              </summary>
              <ul class="language-menu__list" role="list">
                {
                  languages.map(({ locale, name, htmlLang, path }) => (
                    <li>
                      <a
                        href={path}
                        hreflang={htmlLang}
                        lang={htmlLang}
                        data-language-option={locale}
                        aria-current={copy.locale === locale ? "page" : undefined}
                      >
                        {name}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </nav>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-shell">
        <a
          class="brand brand--footer"
          href={homePath}
          aria-label={`${copy.brandLabel} ${copy.navigation.homeLabel}`}
        >
          <img
            class="brand__mark"
            src="/brand/kokage-app-icon.svg"
            alt=""
            width="32"
            height="32"
            loading="lazy"
          />
          <span class="brand__name">{copy.brandLabel}</span>
        </a>
        <p>{copy.footer.descriptor}</p>
        <nav class="footer-nav" aria-label={copy.footer.navigationLabel}>
          <a href={isHomePage ? "#status" : `${homePath}#status`}>
            {copy.footer.statusLink}
          </a>
          <a href={cloudAccountUrl} rel="external">
            {copy.footer.cloudLink}
          </a>
          <a
            href={privacyPath}
            aria-current={page?.kind === "privacy" ? "page" : undefined}
          >
            {copy.footer.privacyLink}
          </a>
          <a
            href={supportPath}
            aria-current={page?.kind === "support" ? "page" : undefined}
          >
            {copy.footer.supportLink}
          </a>
          <span class="footer-nav__social">
            <a
              class="footer-nav__icon"
              href={communityLinks.x.href}
              rel="external me"
              aria-label={copy.footer.xLink}
              title={copy.footer.xLink}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" />
              </svg>
            </a>
            <a
              class="footer-nav__icon"
              href={communityLinks.discord.href}
              rel="external"
              aria-label={copy.footer.discordLink}
              title={copy.footer.discordLink}
            >
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .078-.01c3.927 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .079.009c.12.099.246.198.373.292a.077.077 0 0 1-.007.128 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.363 1.225 1.993a.076.076 0 0 0 .084.029 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03ZM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z" />
              </svg>
            </a>
          </span>
        </nav>
      </div>
    </footer>
  </body>
</html>
