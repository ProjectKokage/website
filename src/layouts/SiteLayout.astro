---
import type { SiteCopy } from "../i18n";
import { localizedRoutes } from "../i18n/routes";
import "../styles/global.css";

interface Props {
  copy: SiteCopy;
  page?: {
    kind: "privacy" | "support";
    title: string;
    description: string;
  };
}

const { copy, page } = Astro.props;
const englishHomeUrl = localizedRoutes.en.home;
const japaneseHomeUrl = localizedRoutes.ja.home;
const englishUrl = page ? localizedRoutes.en[page.kind] : englishHomeUrl;
const japaneseUrl = page ? localizedRoutes.ja[page.kind] : japaneseHomeUrl;
const canonicalPath = copy.locale === "en" ? englishUrl : japaneseUrl;
const homePath = copy.locale === "en" ? englishHomeUrl : japaneseHomeUrl;
const privacyPath = localizedRoutes[copy.locale].privacy;
const supportPath = localizedRoutes[copy.locale].support;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const englishAbsoluteUrl = new URL(englishUrl, Astro.site);
const japaneseAbsoluteUrl = new URL(japaneseUrl, Astro.site);
const imageUrl = new URL("/brand/kokage-app-icon.png", Astro.site);
const meta = page ?? copy.meta;
const isHomePage = page === undefined;
const schema = {
  "@context": "https://schema.org",
  "@type": isHomePage ? "WebSite" : "WebPage",
  name: isHomePage ? copy.brandLabel : meta.title,
  url: canonicalUrl.href,
  description: meta.description,
  inLanguage: copy.htmlLang,
  ...(isHomePage
    ? {}
    : {
        isPartOf: {
          "@type": "WebSite",
          name: copy.brandLabel,
          url: new URL(homePath, Astro.site).href,
        },
      }),
};
---

<!doctype html>
<html
  lang={copy.htmlLang}
  data-site-locale={copy.locale}
  data-english-url={englishUrl}
  data-japanese-url={japaneseUrl}
  data-language-auto-detect={copy.locale === "en" ? "true" : "false"}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d1411" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="index, follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic&amp;display=swap"
    />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishAbsoluteUrl} />
    <link rel="alternate" hreflang="ja" href={japaneseAbsoluteUrl} />
    <link rel="alternate" hreflang="x-default" href={englishAbsoluteUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.brandLabel} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta property="og:locale:alternate" content={copy.alternateOgLocale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content={copy.hero.imageAlt} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={copy.hero.imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/brand/kokage-app-icon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/kokage-app-icon-192.png" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script>
      import { initializeLanguagePreference } from "../scripts/language-preference.mjs";

      initializeLanguagePreference();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{copy.skipLink}</a>

    <header class="site-header">
      <div class="header-shell">
        <a
          class="brand"
          href={homePath}
          aria-label={`${copy.brandLabel} ${copy.navigation.homeLabel}`}
        >
          <img
            class="brand__mark"
            src="/brand/kokage-app-icon.svg"
            alt=""
            width="40"
            height="40"
          />
          <span class="brand__name">{copy.brandLabel}</span>
        </a>

        <nav class="site-nav" aria-label={copy.navigation.label}>
          {
            copy.navigation.items.map((item) => (
              <a href={isHomePage ? item.href : `${homePath}${item.href}`}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <nav class="language-switch" aria-label={copy.navigation.languageLabel}>
          <a
            href={englishUrl}
            hreflang="en"
            lang="en"
            data-language-option="en"
            aria-current={copy.locale === "en" ? "page" : undefined}
          >
            EN
          </a>
          <span aria-hidden="true">/</span>
          <a
            href={japaneseUrl}
            hreflang="ja"
            lang="ja"
            data-language-option="ja"
            aria-current={copy.locale === "ja" ? "page" : undefined}
          >
            日本語
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-shell">
        <a
          class="brand brand--footer"
          href={homePath}
          aria-label={`${copy.brandLabel} ${copy.navigation.homeLabel}`}
        >
          <img
            class="brand__mark"
            src="/brand/kokage-app-icon.svg"
            alt=""
            width="40"
            height="40"
            loading="lazy"
          />
          <span class="brand__name">{copy.brandLabel}</span>
        </a>
        <p>{copy.footer.descriptor}</p>
        <nav class="footer-nav" aria-label={copy.footer.navigationLabel}>
          <a href={isHomePage ? "#status" : `${homePath}#status`}>
            {copy.footer.statusLink}
          </a>
          <a
            href={privacyPath}
            aria-current={page?.kind === "privacy" ? "page" : undefined}
          >
            {copy.footer.privacyLink}
          </a>
          <a
            href={supportPath}
            aria-current={page?.kind === "support" ? "page" : undefined}
          >
            {copy.footer.supportLink}
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>
