---
import type { SiteCopy } from "../i18n";
import {
  kokageCloudUrls,
  localizedRoutes,
  storeListings,
} from "../i18n/routes";
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
const privacyPolicyPath = localizedRoutes[copy.locale].privacy;
const cloudAccountUrl = kokageCloudUrls[copy.locale];
---

<SiteLayout copy={copy}>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__grid page-shell">
        <div class="hero__copy">
          <h1 id="hero-title" class="hero__title reveal reveal--one">
            {copy.hero.title}
          </h1>
          <p class="hero__lede reveal reveal--two">{copy.hero.lede}</p>
          <div class="hero__actions reveal reveal--three">
            <a
              class="button button--primary"
              href={storeListings.appStore}
              rel="external"
            >
              {copy.hero.appStoreAction}
              <span aria-hidden="true">↗</span>
            </a>
            <a
              class="button button--secondary"
              href={storeListings.googlePlay}
              rel="external"
            >
              {copy.hero.googlePlayAction}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="hero-portrait reveal reveal--two">
          <img
            src="/brand/kokochan-preview.png"
            alt={copy.hero.portraitAlt}
            width="640"
            height="640"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section
      id="features"
      class="section section--features"
      aria-labelledby="features-title"
    >
      <div class="page-shell">
        <h2 id="features-title" class="section-title">{copy.features.title}</h2>

        <ul class="feature-list" role="list">
          {
            copy.features.items.map((item) => (
              <li class="feature-item">
                <span class="feature-icon" aria-hidden="true">
                  {item.kind === "voice" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Zm-6 9a6 6 0 0 0 12 0M12 18v3" />
                    </svg>
                  )}
                  {item.kind === "scene" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path d="M12 3v3m0 12v3M3 12h3m12 0h3m-3.6-6.4-2.1 2.1m-6.6 6.6-2.1 2.1m0-10.8 2.1 2.1m6.6 6.6 2.1 2.1" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                  )}
                  {item.kind === "memory" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path d="M5 5h14v14H5z" />
                      <path d="M9 9h6M9 13h4" />
                    </svg>
                  )}
                  {item.kind === "characters" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <circle cx="9" cy="9" r="3.5" />
                      <path d="M3 19c.6-3 3-4.5 6-4.5s5.4 1.5 6 4.5" />
                      <circle cx="17" cy="9.5" r="2.5" />
                      <path d="M17.5 14.5c1.8.4 3.1 1.6 3.5 3.5" />
                    </svg>
                  )}
                  {item.kind === "modes" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <rect x="6" y="3" width="12" height="18" rx="2" />
                      <path d="M10 17h4" />
                    </svg>
                  )}
                  {item.kind === "home" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1v-9.5Z" />
                    </svg>
                  )}
                </span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      id="cloud"
      class="section section--cloud"
      aria-labelledby="cloud-title"
    >
      <div class="page-shell">
        <div class="section-intro">
          <h2 id="cloud-title" class="section-title">{copy.cloud.title}</h2>
          <p class="section-subtitle">{copy.cloud.lede}</p>
        </div>

        <ul class="cloud-list" role="list">
          {
            copy.cloud.items.map((item) => (
              <li class="cloud-item">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>

        <div class="section-links">
          <a
            class="inline-link inline-link--accent"
            href={cloudAccountUrl}
            rel="external"
          >
            {copy.cloud.accountLink}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section
      id="privacy"
      class="section section--privacy"
      aria-labelledby="privacy-title"
    >
      <div class="page-shell">
        <h2 id="privacy-title" class="section-title">{copy.privacy.title}</h2>

        <ul class="privacy-points" role="list">
          {copy.privacy.points.map((point) => <li>{point}</li>)}
        </ul>

        <div class="section-links">
          <a class="privacy-policy-link" href={privacyPolicyPath}>
            {copy.privacy.policyLink}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section
      id="status"
      class="section section--status"
      aria-labelledby="status-title"
    >
      <div class="page-shell closing-band">
        <h2 id="status-title" class="section-title">{copy.status.title}</h2>
        <div class="closing-links">
          {
            copy.status.platforms.map((platform) => (
              <div class="closing-platform">
                <span class="closing-platform__name">{platform.name}</span>
                <a
                  class="inline-link inline-link--accent"
                  href={platform.link.href}
                  rel="external"
                >
                  {platform.link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
