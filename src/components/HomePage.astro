---
import type { SiteCopy } from "../i18n";
import {
  kokageCloudUrls,
  localizedRoutes,
  storeListings,
} from "../i18n/routes";
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
const privacyPolicyPath = localizedRoutes[copy.locale].privacy;
const cloudAccountUrl = kokageCloudUrls[copy.locale];
---

<SiteLayout copy={copy}>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__grid page-shell">
        <div class="hero__copy">
          <h1 id="hero-title" class="hero__title">
            {copy.hero.title}
          </h1>
          <p class="hero__lede">{copy.hero.lede}</p>
          <div class="hero__actions">
            <a
              class="button button--store"
              href={storeListings.appStore}
              rel="external"
            >
              <svg
                class="button__icon"
                viewBox="0 0 24 24"
                width="17"
                height="17"
                aria-hidden="true"
              >
                <path d="M16.365 1.43c0 1.14-.493 2.27-1.177 3.08-.744.9-1.99 1.57-2.987 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.572-2.27 1.206-2.98.804-.94 2.142-1.64 3.248-1.68.03.13.05.28.05.43Zm4.565 15.71c-.03.07-.463 1.58-1.518 3.12-.945 1.34-1.94 2.71-3.43 2.71-1.517 0-1.9-.88-3.63-.88-1.698 0-2.302.91-3.67.91-1.377 0-2.332-1.26-3.428-2.8-1.287-1.82-2.323-4.63-2.323-7.28 0-4.28 2.797-6.55 5.552-6.55 1.448 0 2.675.95 3.6.95.865 0 2.222-1.01 3.902-1.01.613 0 2.886.06 4.374 2.19-.13.09-2.383 1.37-2.383 4.19 0 3.26 2.854 4.42 2.955 4.45Z" />
              </svg>
              <span>{copy.hero.appStoreAction}</span>
              <span class="button__arrow" aria-hidden="true">↗</span>
            </a>
            <a
              class="button button--store"
              href={storeListings.googlePlay}
              rel="external"
            >
              <svg
                class="button__icon"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <path d="M3.609 1.814 13.792 12 3.61 22.186a1.72 1.72 0 0 1-.61-1.318V3.132c0-.517.232-.982.609-1.318Zm11.244 11.244 2.79 2.79-11.2 6.388 8.41-9.178Zm3.748-2.138 2.41 1.374c.99.565.99 1.99 0 2.555l-2.41 1.374-3.04-3.04 3.04-2.263Zm-3.748-1.106-8.41-9.178 11.2 6.388-2.79 2.79Z" />
              </svg>
              <span>{copy.hero.googlePlayAction}</span>
              <span class="button__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="hero-arch">
          <img
            class="hero-arch__leaves"
            src="/brand/kokage-leaves.svg"
            alt=""
            width="370"
            height="263"
            aria-hidden="true"
          />
          <img
            class="hero-arch__character"
            src="/brand/kokochan-preview.png"
            alt={copy.hero.portraitAlt}
            width="640"
            height="640"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section
      id="features"
      class="section section--features"
      aria-labelledby="features-title"
    >
      <div class="page-shell">
        <h2 id="features-title" class="section-title">{copy.features.title}</h2>

        <ul class="feature-list" role="list">
          {
            copy.features.items.map((item) => (
              <li class="feature-item">
                <span class="feature-icon" aria-hidden="true">
                  {item.kind === "voice" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Zm-6 9a6 6 0 0 0 12 0M12 18v3" />
                    </svg>
                  )}
                  {item.kind === "scene" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path d="M12 3v3m0 12v3M3 12h3m12 0h3m-3.6-6.4-2.1 2.1m-6.6 6.6-2.1 2.1m0-10.8 2.1 2.1m6.6 6.6 2.1 2.1" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                  )}
                  {item.kind === "memory" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path d="M5 5h14v14H5z" />
                      <path d="M9 9h6M9 13h4" />
                    </svg>
                  )}
                  {item.kind === "characters" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <circle cx="9" cy="9" r="3.5" />
                      <path d="M3 19c.6-3 3-4.5 6-4.5s5.4 1.5 6 4.5" />
                      <circle cx="17" cy="9.5" r="2.5" />
                      <path d="M17.5 14.5c1.8.4 3.1 1.6 3.5 3.5" />
                    </svg>
                  )}
                  {item.kind === "modes" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <rect x="6" y="3" width="12" height="18" rx="2" />
                      <path d="M10 17h4" />
                    </svg>
                  )}
                  {item.kind === "home" && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1v-9.5Z" />
                    </svg>
                  )}
                </span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      id="cloud"
      class="section section--cloud"
      aria-labelledby="cloud-title"
    >
      <div class="page-shell">
        <div class="section-intro">
          <h2 id="cloud-title" class="section-title">{copy.cloud.title}</h2>
          <p class="section-subtitle">{copy.cloud.lede}</p>
        </div>

        <ul class="cloud-list" role="list">
          {
            copy.cloud.items.map((item) => (
              <li class="cloud-item">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>

        <div class="section-links">
          <a
            class="inline-link inline-link--on-dark"
            href={cloudAccountUrl}
            rel="external"
          >
            {copy.cloud.accountLink}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section
      id="privacy"
      class="section section--privacy"
      aria-labelledby="privacy-title"
    >
      <div class="page-shell">
        <h2 id="privacy-title" class="section-title">{copy.privacy.title}</h2>

        <ul class="privacy-points" role="list">
          {copy.privacy.points.map((point) => <li>{point}</li>)}
        </ul>

        <div class="section-links">
          <a class="privacy-policy-link" href={privacyPolicyPath}>
            {copy.privacy.policyLink}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section
      id="status"
      class="section section--status"
      aria-labelledby="status-title"
    >
      <div class="page-shell closing-band">
        <h2 id="status-title" class="section-title">{copy.status.title}</h2>
        <div class="closing-links">
          {
            copy.status.platforms.map((platform, idx) => (
              <div class="closing-platform">
                <span class="closing-platform__name">{platform.name}</span>
                <a
                  class="inline-link"
                  href={platform.link.href}
                  rel="external"
                >
                  {idx === 0 ? (
                    <svg
                      class="inline-link__icon"
                      viewBox="0 0 24 24"
                      width="15"
                      height="15"
                      aria-hidden="true"
                    >
                      <path d="M16.365 1.43c0 1.14-.493 2.27-1.177 3.08-.744.9-1.99 1.57-2.987 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.572-2.27 1.206-2.98.804-.94 2.142-1.64 3.248-1.68.03.13.05.28.05.43Zm4.565 15.71c-.03.07-.463 1.58-1.518 3.12-.945 1.34-1.94 2.71-3.43 2.71-1.517 0-1.9-.88-3.63-.88-1.698 0-2.302.91-3.67.91-1.377 0-2.332-1.26-3.428-2.8-1.287-1.82-2.323-4.63-2.323-7.28 0-4.28 2.797-6.55 5.552-6.55 1.448 0 2.675.95 3.6.95.865 0 2.222-1.01 3.902-1.01.613 0 2.886.06 4.374 2.19-.13.09-2.383 1.37-2.383 4.19 0 3.26 2.854 4.42 2.955 4.45Z" />
                    </svg>
                  ) : (
                    <svg
                      class="inline-link__icon"
                      viewBox="0 0 24 24"
                      width="14"
                      height="14"
                      aria-hidden="true"
                    >
                      <path d="M3.609 1.814 13.792 12 3.61 22.186a1.72 1.72 0 0 1-.61-1.318V3.132c0-.517.232-.982.609-1.318Zm11.244 11.244 2.79 2.79-11.2 6.388 8.41-9.178Zm3.748-2.138 2.41 1.374c.99.565.99 1.99 0 2.555l-2.41 1.374-3.04-3.04 3.04-2.263Zm-3.748-1.106-8.41-9.178 11.2 6.388-2.79 2.79Z" />
                    </svg>
                  )}
                  <span>{platform.link.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
